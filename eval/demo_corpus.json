    "doc_id": "kb-spec",
    "title": "产品参数",
    "text": "长期停用\n\n超过 7 天不使用时，请排空水箱并取出滤芯晾干后存放。",
    "section_path": ["产品参数", "长期停用"],
    "audience": "public",
    "source_url": "https://example.invalid/docs/spec"
  },
