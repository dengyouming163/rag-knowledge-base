    "doc_id": "kb-spec",
    "title": "产品参数",
    "text": "包装清单\n\n包装内含主机一台、滤芯一支、说明书一份、电源线一根。",
    "section_path": ["产品参数", "包装清单"],
    "audience": "public",
    "source_url": "https://example.invalid/docs/spec"
