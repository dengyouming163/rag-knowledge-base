LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

EMBED_API_KEY=
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3

# 精排服务（留空 = 不启用，直接使用粗排结果）
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=bge-reranker-v2-m3

# PDF 解析服务（留空 = 用本地 pypdf 降级；起容器时填 http://localhost:8100）
PARSER_BASE_URL=

# 本地 docker compose 起的 pgvector（deploy/docker-compose.yml）
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=kb
DB_PASSWORD=kb
# 业务连接用非超级用户：超级用户会绕过 RLS
DB_APP_USER=kb_app
DB_APP_PASSWORD=kb_app
DB_NAME=kb

# 原始文件存储：local（默认，写 data/uploads）| s3（MinIO / 云对象存储）
# 宿主机直跑填 http://127.0.0.1:9000；compose 内固定走服务名 http://minio:9000
STORAGE_BACKEND=local
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=rag-kb
# 应用使用受限账号：只允许读写 rag-kb 桶（由 minio-init 自动创建，别用 root）
S3_ACCESS_KEY=rag-app
S3_SECRET_KEY=rag-app-secret
S3_REGION=us-east-1
S3_USE_SSL=false

# MinIO：root 仅用于初始化，日常不要给应用用
MINIO_ROOT_USER=ragkb
MINIO_ROOT_PASSWORD=ragkb-secret
# 控制台只读查看账号：登录 http://127.0.0.1:9001 浏览，不能增删改
MINIO_VIEWER_USER=rag-viewer
MINIO_VIEWER_PASSWORD=rag-viewer-secret
